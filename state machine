deploy:
  stage: deploy
  dependencies:
    - build
  image: mcr.microsoft.com/powershell:7.4.1-ubuntu-22.04
  before_script:
    - apt-get update && apt-get install -y jq awscli curl krb5-user
  script:
    # --- Fetch VM details from Terraform state ---
    - aws s3 cp s3://my-terraform-states/nutanix_vm_state.json vm_state.json
    - VM_HOST=$(jq -r '.resources[] | select(.type=="nutanix_vm") | .instances[0].attributes.ip_address' vm_state.json)
    - echo "Deploying to VM: $VM_HOST"

    # --- Get AD service account from AWS Secrets Manager ---
    - CREDS_JSON=$(aws secretsmanager get-secret-value --secret-id my-ad-service-account --query SecretString --output text)
    - KRB_USER=$(echo $CREDS_JSON | jq -r '.username')   # e.g. svc_deploy@CORP.LOCAL
    - KRB_PASS=$(echo $CREDS_JSON | jq -r '.password')

    # --- Authenticate with Kerberos ---
    - echo $KRB_PASS | kinit $KRB_USER

    # --- Download WHL from Nexus (exact version from build stage) ---
    - curl -u $NEXUS_USER:$NEXUS_PASS -O "https://nexus.example.com/repository/pypi-group/${WHL_FILE}"

    # --- Use PowerShell remoting to install WHL on Windows VM ---
    - pwsh -Command "
        \$secpass = ConvertTo-SecureString '$KRB_PASS' -AsPlainText -Force;
        \$cred = New-Object System.Management.Automation.PSCredential('$KRB_USER', \$secpass);
        Invoke-Command -ComputerName $VM_HOST -Credential \$cred -Authentication Kerberos -ScriptBlock {
          \$nexusUrl = 'https://nexus.example.com/repository/pypi-group/${WHL_FILE}';
          \$whlPath = 'C:\\Temp\\' + (Split-Path \$nexusUrl -Leaf);
          Invoke-WebRequest -Uri \$nexusUrl -OutFile \$whlPath -UseBasicParsing;
          pip install \$whlPath --upgrade
        }
      "
stages:
  - build
  - deploy

deploy:
  stage: deploy
  image: mcr.microsoft.com/powershell:7.4.1-ubuntu-22.04
  variables:
    DEPLOY_USER:
      description: "Enter the AD service account (e.g. svc_deploy@CORP.LOCAL)"
      value: ""
    DEPLOY_PASS:
      description: "Enter the AD service account password"
      value: ""
      masked: true
  script:
    - apt-get update && apt-get install -y krb5-user jq
    # Authenticate with Kerberos using user-supplied creds
    - echo "$DEPLOY_PASS" | kinit "$DEPLOY_USER"

    # Example PowerShell remote deploy
    - pwsh -Command "
        \$secpass = ConvertTo-SecureString '$DEPLOY_PASS' -AsPlainText -Force;
        \$cred = New-Object System.Management.Automation.PSCredential('$DEPLOY_USER', \$secpass);
        Invoke-Command -ComputerName $VM_HOST -Credential \$cred -Authentication Kerberos -ScriptBlock {
          pip install C:\Temp\$(Split-Path '${WHL_FILE}' -Leaf) --upgrade
        }
      "
stages:
  - build
  - deploy

build:
  stage: build
  image: python:3.11
  script:
    - python setup.py bdist_wheel
    - ls dist/*.whl
    # extract version from filename, e.g. mypkg-1.2.3-py3-none-any.whl
    - WHL_FILE=$(ls dist/*.whl | head -n1)
    - echo $WHL_FILE > whl_file.txt
    - basename $WHL_FILE | cut -d- -f2 > whl_version.txt
  artifacts:
    paths:
      - dist/*.whl
      - whl_file.txt
      - whl_version.txt
    expire_in: 1 week

deploy:
  stage: deploy
  needs: ["build"]
  script:
    # Read version from artifacts
    - WHL_FILE=$(cat whl_file.txt)
    - WHL_VERSION=$(cat whl_version.txt)
    - echo "Deploying wheel version $WHL_VERSION"
    # Example PowerShell remote copy + install
    - pwsh -Command "
        \$secpass = ConvertTo-SecureString '$DEPLOY_PASS' -AsPlainText -Force;
        \$cred = New-Object System.Management.Automation.PSCredential('$DEPLOY_USER', \$secpass);
        Copy-Item -ToSession (New-PSSession -ComputerName $VM_HOST -Credential \$cred -Authentication Negotiate) -Path $WHL_FILE -Destination 'C:\Temp\';
        Invoke-Command -ComputerName $VM_HOST -Credential \$cred -Authentication Negotiate -ScriptBlock {
          pip install C:\Temp\$(Split-Path '$WHL_FILE' -Leaf) --upgrade
        }
      "
